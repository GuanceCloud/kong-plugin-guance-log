# Install under <DataKit>/pipeline/guance-log.p.
# Keep json_as_fields=false so this script receives the original JSON message.
json(_, schema_version)
json(_, timestamp_ms)
json(_, status)
json(_, request_id)
json(_, http_method)
json(_, http_path)
json(_, http_status)
json(_, request_bytes)
json(_, response_bytes)
json(_, client_ip)
json(_, duration)
json(_, request_time_ms)
json(_, kong_latency_ms)
json(_, upstream_latency_ms)
json(_, receive_time_ms)
json(_, kong_service_id)
json(_, kong_service_name)
json(_, kong_route_id)
json(_, kong_route_name)
json(_, consumer_id)
json(_, workspace_id)
json(_, workspace_name)
json(_, response_source)
json(_, trace_id)
json(_, parent_span_id)
json(_, trace_flags)
json(_, trace_id_source)
gjson(_, "request_headers", "request_headers")
gjson(_, "response_headers", "response_headers")
if timestamp_ms != nil {
  json(_, timestamp_ms, time)
  cast(time, "str")
  default_time(time)
}
